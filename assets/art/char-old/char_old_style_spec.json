        10,
        10,
        12
      ],
      "zone": "all",
      "note": "近黑轮廓"
    },
    {
      "name": "hair_dark",
      "rgb": [
        43,
        38,
        36
      ],
      "zone": "head",
      "note": "发色最深"
    },
    {
      "name": "hair_mid",
      "rgb": [
        63,
        52,
        46
      ],
      "zone": "head",
      "note": "主发色"
    },
    {
      "name": "hair_light",
      "rgb": [
        97,
        83,
        68
      ],
      "zone": "head",
